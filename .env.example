# Copy to .env for local development. Never commit the populated file.
# In deployed environments these arrive as Azure Container App secrets.

# --- System Chatbot agent (management-console/management-backend) ---
# Used by system_llm.py's OpenAI Agents SDK agent.
OPENAI_API_KEY=
# Set when running the management-frontend Vite dev server (port 5174)
# against this API locally.
MANAGEMENT_CORS_ALLOW_ORIGINS=http://localhost:5174

# --- Analytics database (shared with the platform's Backend/analytics_api) ---
# Read directly if set:
#   ANALYTICS_DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# Otherwise built from the individual variables below.
analytics_postgres_host=
analytics_postgres_port=5432
analytics_postgres_username=
analytics_postgres_password=
analytics_database=
